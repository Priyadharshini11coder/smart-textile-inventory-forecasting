# ==============================================================================
# JP Agencies - Smart Textile Inventory & ML Demand Forecasting System
# Environment Configuration
# ==============================================================================

# Backend Port
PORT=5000

# MongoDB Connection String
# If MongoDB is not running locally, the system automatically uses its built-in
# high-fidelity persistent JSON store (zero setup required for college evaluation).
# To use MongoDB Atlas or local MongoDB daemon, set:
MONGODB_URI=mongodb://127.0.0.1:27017/jp_agencies_textile

# Python ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:5001

# Environment
NODE_ENV=development
